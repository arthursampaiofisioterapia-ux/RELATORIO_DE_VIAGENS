/*************************************************
 * CONFIGURAÇÕES
 *************************************************/
var CONFIG = {
  NOME_PLANILHA: 'RELATORIOS_DE_VIAGENS',
  NOME_ABA: '', // deixe vazio para usar a primeira aba
  CABECALHO_PROCESSO: 'Número processo',
  CABECALHOS_CIDADE_POSSIVEIS: ['Cidade', 'Município', 'Municipio', 'Local'],

  // ID do modelo Google Docs
  TEMPLATE_DOC_ID: '1WeU9n6b132LQ2_046npUfjYH7odxVgVSQrz-V0rNzK4',

  // Nome base do documento gerado
  NOME_DOCUMENTO_GERADO: 'RELATORIO_DE_VIAGENS - GERADO'
};

/*************************************************
 * FUNÇÃO PRINCIPAL (ORQUESTRADORA)
 * - Lê a planilha RELATORIOS_DE_VIAGENS
 * - Ordena pela coluna "Número processo"
 * - Monta a lista de cidades únicas
 * - Chama funções de DATAS.gs para obter primeira/última data
 * - Chama funções de TRECHO_VIAJADO.gs para montar variável {1}
 * - Cria um Google Docs a partir do modelo
 * - Substitui {CIDADES_VISITADAS}, {PRIMEIRA_DATA}, {ULTIMA_DATA} e {1}
 *************************************************/
function gerarRelatorioComCidades() {
  var ss = abrirPlanilhaPorNome_(CONFIG.NOME_PLANILHA);
  var sheet = CONFIG.NOME_ABA
    ? ss.getSheetByName(CONFIG.NOME_ABA)
    : ss.getSheets()[0];

  if (!sheet) {
    throw new Error('Não foi possível localizar a aba de dados.');
  }

  var dados = sheet.getDataRange().getValues();

  if (dados.length < 2) {
    throw new Error('A planilha não possui dados suficientes.');
  }

  var cabecalhos = dados[0];

  var idxProcesso = encontrarIndiceColuna_(cabecalhos, [CONFIG.CABECALHO_PROCESSO]);
  if (idxProcesso === -1) {
    throw new Error('Coluna "Número processo" não encontrada.');
  }

  var idxCidade = encontrarIndiceColuna_(cabecalhos, CONFIG.CABECALHOS_CIDADE_POSSIVEIS);
  if (idxCidade === -1) {
    throw new Error(
      'Nenhuma coluna de cidade foi encontrada. Verifique se o cabeçalho é "Cidade", "Município", "Municipio" ou "Local".'
    );
  }

  var linhas = dados.slice(1);

  /*************************************************
   * 1) ORDENAR AS LINHAS POR NÚMERO PROCESSO
   *************************************************/
  linhas.sort(function(a, b) {
    var numA = extrairNumero_(a[idxProcesso]);
    var numB = extrairNumero_(b[idxProcesso]);
    return numA - numB;
  });

  // Reescreve a planilha já ordenada
  sheet.getRange(2, 1, linhas.length, cabecalhos.length).setValues(linhas);

  /*************************************************
   * 2) GERAR LISTA DE CIDADES ÚNICAS
   *************************************************/
  var cidadesUnicas = [];
  var cidadesJaVistas = {};

  for (var i = 0; i < linhas.length; i++) {
    var linha = linhas[i];
    var cidadeBruta = linha[idxCidade];

    if (cidadeBruta === '' || cidadeBruta === null || cidadeBruta === undefined) {
      continue;
    }

    var cidadeFormatada = formatarCidade_(cidadeBruta);
    var chaveCidade = normalizarChave_(cidadeFormatada);

    if (!cidadesJaVistas[chaveCidade]) {
      cidadesJaVistas[chaveCidade] = true;
      cidadesUnicas.push(cidadeFormatada);
    }
  }

  var listaCidades = cidadesUnicas.join('; ');
  Logger.log('Cidades únicas: ' + listaCidades);

  /*************************************************
   * 3) OBTER INTERVALO DE DATAS (arquivo DATAS.gs)
   *************************************************/
  var intervaloDatas = obterIntervaloDatas_(cabecalhos, linhas);

  /*************************************************
   * 4) MONTAR TRECHO VIAJADO POR DIA (TRECHO_VIAJADO.gs)
   *************************************************/
  var trechoViajado = montarTrechoViajadoComDatas_(cabecalhos, linhas);

  /*************************************************
   * 5) CRIAR CÓPIA DO MODELO
   *************************************************/
  var templateId = limparIdGoogle_(CONFIG.TEMPLATE_DOC_ID);
  var templateFile = DriveApp.getFileById(templateId);

  var dataHora = Utilities.formatDate(
    new Date(),
    Session.getScriptTimeZone(),
    'yyyy-MM-dd HH:mm:ss'
  );

  var nomeNovoDocumento = CONFIG.NOME_DOCUMENTO_GERADO + ' - ' + dataHora;
  var copia = templateFile.makeCopy(nomeNovoDocumento);

  /*************************************************
   * 6) ABRIR A CÓPIA E SUBSTITUIR VARIÁVEIS
   *************************************************/
  var doc = DocumentApp.openById(copia.getId());
  var body = doc.getBody();

  body.replaceText('\\{CIDADES_VISITADAS\\}', listaCidades);
  body.replaceText('\\{PRIMEIRA_DATA\\}', intervaloDatas.primeiraData);
  body.replaceText('\\{ULTIMA_DATA\\}', intervaloDatas.ultimaData);
  body.replaceText('\\{1\\}', trechoViajado);

  doc.saveAndClose();

  var urlDocumento = 'https://docs.google.com/document/d/' + copia.getId() + '/edit';

  Logger.log('Documento gerado com sucesso: ' + urlDocumento);

  return {
    cidades: listaCidades,
    primeiraData: intervaloDatas.primeiraData,
    ultimaData: intervaloDatas.ultimaData,
    trechoViajado: trechoViajado,
    docId: copia.getId(),
    docUrl: urlDocumento
  };
}

/*************************************************
 * ABRIR PLANILHA PELO NOME DO ARQUIVO
 *************************************************/
function abrirPlanilhaPorNome_(nomeArquivo) {
  var arquivos = DriveApp.getFilesByName(nomeArquivo);

  if (!arquivos.hasNext()) {
    throw new Error('Arquivo Google Planilhas não encontrado com o nome: ' + nomeArquivo);
  }

  var arquivo = arquivos.next();
  return SpreadsheetApp.openById(arquivo.getId());
}

/*************************************************
 * ENCONTRAR ÍNDICE DA COLUNA
 *************************************************/
function encontrarIndiceColuna_(cabecalhos, nomesPossiveis) {
  var cabecalhosNormalizados = [];
  for (var i = 0; i < cabecalhos.length; i++) {
    cabecalhosNormalizados.push(normalizarCabecalho_(cabecalhos[i]));
  }

  for (var j = 0; j < nomesPossiveis.length; j++) {
    var nomeNormalizado = normalizarCabecalho_(nomesPossiveis[j]);
    var idx = cabecalhosNormalizados.indexOf(nomeNormalizado);
    if (idx !== -1) return idx;
  }

  return -1;
}

/*************************************************
 * NORMALIZAR CABEÇALHO
 *************************************************/
function normalizarCabecalho_(texto) {
  return String(texto || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
}

/*************************************************
 * EXTRAIR NÚMERO PARA ORDENAÇÃO
 * Ex.: "123", "000123", "Proc. 123/2025"
 *************************************************/
function extrairNumero_(valor) {
  var texto = String(valor || '').trim();

  if (!texto) return Number.MAX_SAFE_INTEGER;

  var direto = Number(texto);
  if (!isNaN(direto)) return direto;

  var match = texto.match(/\d+/);
  if (match) return Number(match[0]);

  return Number.MAX_SAFE_INTEGER;
}

/*************************************************
 * FORMATAR CIDADE
 * Ex.: "belo horizonte" -> "Belo Horizonte"
 *************************************************/
function formatarCidade_(cidade) {
  return String(cidade || '')
    .trim()
    .toLowerCase()
    .split(/\s+/)
    .map(function(palavra) {
      return palavra.charAt(0).toUpperCase() + palavra.slice(1);
    })
    .join(' ');
}

/*************************************************
 * NORMALIZAR CHAVE PARA REMOVER REPETIÇÕES
 *************************************************/
function normalizarChave_(texto) {
  return String(texto || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '');
}

/*************************************************
 * LIMPAR ID GOOGLE
 * Aceita ID puro, URL completa, ou texto com /edit
 *************************************************/
function limparIdGoogle_(texto) {
  var valor = String(texto || '').trim();
  var match = valor.match(/[-\w]{25,}/);
  return match ? match[0] : valor;
}
